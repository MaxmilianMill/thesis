# Copy this file to .env and fill in your values.
# docker compose automatically loads .env from this directory.

# ── Server ─────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_NAME=master-thesis
MONGODB_NAME_TEST=master-thesis-test
JWT_SECRET=<your-secret>
GEMINI_API_KEY=<your-gemini-api-key>
AI_WEBSOCKET_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent

# CORS_ORIGIN must match the URL the client is served from.
# Default: http://localhost:5173 (client port in docker-compose)
# CORS_ORIGIN=http://localhost:5173

# ── Client (baked into the JS bundle at build time) ────────────────────────────
# Override these only if you change the server's host port or deploy remotely.
# VITE_SERVER_URL=http://localhost:8080/api/v1
# VITE_WS_SERVER_URL=ws://localhost:8080/ws/chat
